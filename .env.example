# Postgres defaults for docker-compose
POSTGRES_USER=user
POSTGRES_PASSWORD=example
POSTGRES_DB=weatherstations
POSTGRES_PORT=5432

# App port on host (the container still listens on 8000 internally)
APP_PORT=8000

# Local (non-container) development DATABASE_URL example:
# DATABASE_URL=postgresql://user:example@localhost:5432/weatherstations
